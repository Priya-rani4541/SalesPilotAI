# Copy this file to ".env" and fill in your own values.
# Never commit the real .env file.

# --- App ---
APP_NAME=SalesPilot AI
APP_VERSION=0.1.0

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- CORS (comma-separated list of allowed frontend origins) ---
CORS_ORIGINS=http://localhost:5173

# --- Database: MongoDB Atlas ---
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=salespilot

# --- AI: Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.4

# --- RAG knowledge base ---
# Embedding model (text-embedding-004 is retired; use a current model).
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Output vector size requested from the embedding model.
RAG_EMBEDDING_DIMENSION=768
# Chunking: target characters per chunk and overlap between neighbours.
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
# Retrieval: how many chunks to fetch and the minimum similarity to trust.
RAG_TOP_K=4
RAG_MIN_SCORE=0.50
# Where the FAISS index and manifest are stored (empty = backend/data/knowledge_base).
RAG_DATA_DIR=

# --- Voice: Vapi ---
VAPI_API_KEY=your_vapi_api_key
VAPI_PHONE_NUMBER_ID=your_vapi_phone_number_id
VAPI_ASSISTANT_ID=your_vapi_assistant_id
VAPI_LLM_MODEL_NAME=salespilot-gemini
# Shared secret Vapi sends as the "x-vapi-secret" header to protect our endpoints.
VAPI_WEBHOOK_SECRET=your_vapi_webhook_secret
# Public HTTPS URL where Vapi can reach this backend (use a tunnel in local dev).
PUBLIC_BASE_URL=https://your-public-url.example.com
